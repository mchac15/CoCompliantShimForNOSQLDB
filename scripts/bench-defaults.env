# The benchmark defaults: the setup of the final comparison (adaptive fanout cap vs speculative vs
# non-speculative, MySQL, 2 shim nodes). scripts/bench-sweep.sh sources it; for a one-off run:
#
#   source scripts/bench-defaults.env
#   OUT=... VARIANTS=... WARMUP_S=$BASE_WARMUP_S MEASURE_S=$BASE_MEASURE_S scripts/bench-final.sh $BENCH_WORKLOAD
#
# Options given after $BENCH_WORKLOAD override it (MicroBench and bench-compare.sh take the last one).

# bench-final.sh / bench-compare.sh
export SKEWS=0.95
export THREADS_LIST="50 100 150 200 400 600 800 1200"
export REPS=1
export SHIMS=2
export PREPARE_DEADLOCK=wait-die      # prepare() votes NO instead of waiting for a younger txn
export LOCK_TIMEOUT_MS=30000          # shim nodes and servers; only breaks cross-database deadlocks
export TXN_TIMEOUT_MS=60000           # the TC's global timeout, a backstop above it

# Measurement windows. The adaptive cap needs its warm-up to settle (about 100-150 s under load at
# 15 s periods); speculative and non-speculative are steady within about 5 s.
ADAPTIVE_WARMUP_S=200
ADAPTIVE_MEASURE_S=120
BASE_WARMUP_S=10
BASE_MEASURE_S=30

# The adaptive fanout cap (SPEC_MAX_FANOUT=auto): anchored hill-climb, F from 2 down to 0 (below
# 0.25) up to 8, 2.5 % margin, x1.4 after a clear gain, x1.2 while flat, re-anchor after 4 flat
# steps, 15 s periods of which 3 s settle. These are also the node's built-in defaults.
ADAPTIVE_FANOUT_ARGS="--spec-fanout-eps 0.025 --spec-fanout-step 0.4 --spec-fanout-small-step 0.2 --spec-fanout-max-flat 4"

# The workload: 2 branches in order (pipelined), 5 reads + 5 writes each (20 ops per txn, read ratio
# 0.5), read-modify-write updates locked up front (get-for-update), 100000 keys per table, skew 0.95
# on every branch, 10 +- 5 ms think time before every op but the first and before the commit (the
# client <-> shim round trip and the work between two requests).
BENCH_WORKLOAD="--ops-mean 0 --branches 2 --reads 5 --writes 5 --table-size 100000 --rmw true --get-for-update true --pipelined-branches true --think-mean-us 10000 --think-sd-us 5000"
